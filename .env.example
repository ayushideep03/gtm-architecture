# ── Environment Configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="GTM Autonomous System"
APP_VERSION=0.1.0

# PostgreSQL — used by SQLAlchemy and Alembic
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://gtm_user:gtm_password@localhost:5432/gtm_db

# Redis — used for caching, pub/sub, and task queues
# Format: redis://host:port/db_number
REDIS_URL=redis://localhost:6379/0

# LLM Providers — the AI Sales Controller uses OpenAI by default (config/gtm.yaml llm.profiles)
# and falls back to Anthropic, then to the deterministic rules engine if neither key is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API / dashboard sign-in: comma-separated name=key pairs (keys >= 16 chars).
# Required outside the development/demo/test profiles (the API answers 503 without it).
# The name is recorded as the reviewer on every approval.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OXYGEN_API_KEYS=
# Extra browser origins allowed to call the API (the dashboard itself is same-origin).
CORS_ORIGINS=

# Config profile overlay (config/gtm.<profile>.yaml); defaults to ENVIRONMENT
GTM_PROFILE=development

# Inbound webhooks (HMAC-SHA256 secret) and lead sources
OXYGEN_WEBHOOK_SECRET=
APOLLO_API_KEY=

# ── Email (any SMTP/IMAP server: Google Workspace, Microsoft 365, SES, self-hosted) ──
# Providers stay "unavailable" until these are set. Outbound mail still requires human approval.
SMTP_HOST=
SMTP_FROM_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=
# Optional self-hosted BillionMail (template must render {{subject}} and {{body}})
BILLIONMAIL_URL=
BILLIONMAIL_API_KEY=
BILLIONMAIL_ADDRESSER=
