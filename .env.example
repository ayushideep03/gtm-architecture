# ── Environment Configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="GTM Autonomous System"
APP_VERSION=0.1.0

# PostgreSQL — used by SQLAlchemy and Alembic
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://gtm_user:gtm_password@localhost:5432/gtm_db

# Redis — used for caching, pub/sub, and task queues
# Format: redis://host:port/db_number
REDIS_URL=redis://localhost:6379/0

# LLM Providers (leave blank if not using yet)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
