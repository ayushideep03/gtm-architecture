# Keep line endings consistent across macOS, Linux and Windows.
# Files are stored with LF in git; Windows checkouts still work fine
# because Python, Alembic and Docker all accept LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.zip binary
*.png binary
*.jpg binary
